---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404">
  <div class="term" style="max-width:38rem;margin:4rem auto">
    <div class="term-bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="term-title">~ 404</span>
    </div>
    <div class="term-body">
      <p class="cmd"><span class="prompt">$</span>打开 /这个页面</p>
      <p class="out" style="color:var(--danger)">错误：找不到 /这个页面</p>
      <p class="cmd"><span class="prompt">$</span>回到首页</p>
      <p class="out"><a href="/" style="color:var(--accent)">返回首页 →</a></p>
    </div>
  </div>
</BaseLayout>
