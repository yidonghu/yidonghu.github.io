---
interface Props {
  slug: string;
  data: Record<string, any>;
}

const { slug, data } = Astro.props;
const tags: string[] = Array.isArray(data.tags) ? data.tags : [];
const statusLabel: Record<string, string> = {
  ok: '有效',
  pending: '待补',
  dead: '已失效',
};
const status = (data.status as string) || 'ok';
const platformLabel: Record<string, string> = {
  baidu: '百度网盘',
  quark: '夸克网盘',
  aliyun: '阿里云盘',
  lanzou: '蓝奏/123',
  github: 'GitHub',
  magnet: '磁力',
};
const platform = (data.platform as string) || 'baidu';
const reportBody = encodeURIComponent(
  `资源：${data.title}\n链接：${data.url}\n问题：链接失效 / 内容异常（请补充说明）\n`
);
const reportUrl = `https://github.com/yidonghu/yidonghu.github.io/issues/new?title=${encodeURIComponent(
  `[资源失效] ${data.title}`
)}&body=${reportBody}`;
---
<article class="res-card" data-platform={platform} data-status={status}>
  <div class="res-head">
    <span class="badge" data-platform={platform}>{platformLabel[platform] ?? platform}</span>
    <span class="badge" data-status={status}>{statusLabel[status] ?? status}</span>
    {data.size && <span>{data.size}</span>}
  </div>

  <h3><a href={`/resources/${slug}/`}>{data.title}</a></h3>

  {data.summary && <p class="res-sum">{data.summary}</p>}

  {tags.length > 0 && <div class="res-tags">{tags.map((t) => <span>#{t}</span>)}</div>}

  <div class="res-actions">
    <button class="btn btn-main" type="button" data-copy={data.url} data-copy-label="链接已复制">复制链接</button>
    {data.code && (
      <button class="btn" type="button" data-copy={data.code} data-copy-label="提取码已复制">
        提取码 {data.code}
      </button>
    )}
    {data.repo && (
      <a class="btn" href={data.repo} target="_blank" rel="noopener" title="打开该资源的源码仓库">GitHub 仓库</a>
    )}
    <a class="btn btn-ghost" href={`/resources/${slug}/`}>详情</a>
    <a class="btn btn-ghost" href={reportUrl} target="_blank" rel="noopener">报告失效</a>
  </div>
</article>
